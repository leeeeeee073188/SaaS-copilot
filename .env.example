# Standalone FlowForge support workspace (synthetic business data).
API_HOST=127.0.0.1
API_PORT=8000
# 0: deterministic demo; 1: Anthropic-compatible model.
SAAS_COPILOT_DEMO_LLM=0
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
SAAS_COPILOT_DEMO_DATA=./data/flowforge
SAAS_COPILOT_DEMO_EMBEDDING=lexical
# Required Redis working memory; SQLite remains the business database.
SAAS_COPILOT_DEMO_REDIS_URL=redis://127.0.0.1:6380/0
# Separate credentials for sandbox clock controls and aggregate metrics.
SAAS_COPILOT_DEMO_CONTROL_KEY=
SAAS_COPILOT_METRICS_TOKEN=
# Optional per-specialist model overrides.
SAAS_COPILOT_TRIAGE_MODEL=
SAAS_COPILOT_SUPPORT_MODEL=
SAAS_COPILOT_SUCCESS_MODEL=
SAAS_COPILOT_AGENT_TIMEOUT=45
SAAS_COPILOT_AGENT_TOOL_MAX_ROUNDS=3
SAAS_COPILOT_COMPOSER_MAX_TOKENS=1100
