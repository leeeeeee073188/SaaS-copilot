# Standalone FlowForge support workspace (synthetic business data).
API_HOST=127.0.0.1
API_PORT=8000
# 0: deterministic demo; 1: Anthropic-compatible model.
ECHOMIND_DEMO_LLM=0
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ECHOMIND_DEMO_DATA=./data/flowforge
ECHOMIND_DEMO_EMBEDDING=lexical
# Optional Redis; blank uses SQLite working memory.
ECHOMIND_DEMO_REDIS_URL=
# Separate credentials for sandbox clock controls and aggregate metrics.
ECHOMIND_DEMO_CONTROL_KEY=
ECHOMIND_METRICS_TOKEN=
# Optional per-specialist model overrides.
ECHOMIND_TRIAGE_MODEL=
ECHOMIND_SUPPORT_MODEL=
ECHOMIND_SUCCESS_MODEL=
ECHOMIND_AGENT_TIMEOUT=45
ECHOMIND_AGENT_TOOL_MAX_ROUNDS=3
ECHOMIND_COMPOSER_MAX_TOKENS=1100
